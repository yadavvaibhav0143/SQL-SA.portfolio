--Active_Accounts%

SELECT 
    Year,
    ROUND(AVG(CAST(Active_Flag AS decimal(5,2))) * 100, 2) AS Active_Accounts_Percent
FROM SA_Project1
GROUP BY Year
ORDER BY Year;


--Avg_Balper_Account

SELECT 
    Year,
    ROUND(AVG(CAST(Average_Balance AS decimal(12,2))), 2) AS Avg_Balance_Per_Account
FROM SA_Project1
GROUP BY Year
ORDER BY Year;


--Churn_Rate%

SELECT 
    Year,
    ROUND(AVG(CAST(Churn_Flag AS decimal(5,2))) * 100, 2) AS Churn_Rate_Percent
FROM SA_Project1
GROUP BY Year
ORDER BY Year;


--Cross-Sell_Ratio

SELECT 
    Year,
    ROUND(AVG(CAST(Cross_Sell_Products_Count AS decimal(5,2))), 2) AS Cross_Sell_Ratio
FROM SA_Project1
GROUP BY Year
ORDER BY Year;


--Etb-Ntb_Contribution

SELECT 
    Year,
    Customer_Type,
    SUM(CAST(Average_Balance AS decimal(12,2))) AS Total_Balance,
    ROUND(
        SUM(CAST(Average_Balance AS decimal(12,2))) * 100.0 /
        SUM(SUM(CAST(Average_Balance AS decimal(12,2)))) OVER (PARTITION BY Year),
        2
    ) AS Contribution_Percent
FROM SA_Project1
GROUP BY Year, Customer_Type
ORDER BY Year, Customer_Type;


--Growth%_YoY

WITH Portfolio AS (
    SELECT 
        Year,
        SUM(CAST(Average_Balance AS decimal(12,2))) AS Total_Portfolio
    FROM SA_Project1
    GROUP BY Year
)
SELECT 
    a.Year,
    a.Total_Portfolio,
    LAG(a.Total_Portfolio) OVER (ORDER BY a.Year) AS Prev_Year_Portfolio,
    ROUND(
        ((a.Total_Portfolio - LAG(a.Total_Portfolio) OVER (ORDER BY a.Year)) 
        / NULLIF(LAG(a.Total_Portfolio) OVER (ORDER BY a.Year),0)) * 100, 2
    ) AS Growth_Percent
FROM Portfolio a;


--Ltv-Cac_Ratio

SELECT 
    Year,
    ROUND(AVG(CAST(Total_Revenue_Per_Year AS decimal(12,2))), 2) AS Avg_Revenue_Per_Year,
    ROUND(AVG(CAST(Customer_Lifetime_Years AS decimal(5,2))), 2) AS Avg_Lifetime_Years,
    ROUND(AVG(CAST(Acquisition_Cost AS decimal(12,2))), 2) AS Avg_CAC,
    ROUND(
        (AVG(CAST(Total_Revenue_Per_Year AS decimal(12,2))) * 
         AVG(CAST(Customer_Lifetime_Years AS decimal(5,2)))) /
        NULLIF(AVG(CAST(Acquisition_Cost AS decimal(12,2))), 0), 2
    ) AS LTV_CAC_Ratio
FROM SA_Project1
GROUP BY Year
ORDER BY Year;


--Total_SA_Portfolio

WITH Portfolio AS (
    SELECT 
        Year,
        SUM(CAST(Average_Balance AS decimal(12,2))) AS Total_Portfolio
    FROM SA_Project1
    GROUP BY Year
)
SELECT 
    a.Year,
    a.Total_Portfolio,
    LAG(a.Total_Portfolio) OVER (ORDER BY a.Year) AS Prev_Year_Portfolio,
    ROUND(
        ((a.Total_Portfolio - LAG(a.Total_Portfolio) OVER (ORDER BY a.Year)) 
        / NULLIF(LAG(a.Total_Portfolio) OVER (ORDER BY a.Year),0)) * 100, 2
    ) AS Growth_Percent
FROM Portfolio a;


--Summary.SA_Project

DROP VIEW IF EXISTS SA_Portfolio_Summary;
GO
CREATE VIEW SA_Portfolio_Summary AS
SELECT 
    Year,
    
    -- Total Portfolio Balance
    SUM(CAST(Average_Balance AS decimal(12,2))) AS Total_Portfolio_Balance,
    
    -- Average Balance per Account
    ROUND(AVG(CAST(Average_Balance AS decimal(12,2))), 2) AS Avg_Balance_Per_Account,
    
    -- Active Accounts %
    ROUND(AVG(CAST(Active_Flag AS decimal(5,2))) * 100, 2) AS Active_Accounts_Percent,
    
    -- Churn Rate %
    ROUND(AVG(CAST(Churn_Flag AS decimal(5,2))) * 100, 2) AS Churn_Rate_Percent,
    
    -- Cross-Sell Ratio
    ROUND(AVG(CAST(Cross_Sell_Products_Count AS decimal(5,2))), 2) AS Cross_Sell_Ratio,
    
    -- Avg Revenue, CAC, Lifetime & LTV:CAC
    ROUND(AVG(CAST(Total_Revenue_Per_Year AS decimal(12,2))), 2) AS Avg_Revenue_Per_Year,
    ROUND(AVG(CAST(Acquisition_Cost AS decimal(12,2))), 2) AS Avg_CAC,
    ROUND(AVG(CAST(Customer_Lifetime_Years AS decimal(5,2))), 2) AS Avg_Lifetime_Years,
    
    ROUND(
        (AVG(CAST(Total_Revenue_Per_Year AS decimal(12,2))) * 
         AVG(CAST(Customer_Lifetime_Years AS decimal(5,2)))) /
        NULLIF(AVG(CAST(Acquisition_Cost AS decimal(12,2))), 0), 2
    ) AS LTV_CAC_Ratio
FROM SA_Project1
GROUP BY Year
